{

    "name": "Auto Snapshot",

    "namespace": "INTERSECT\\AutoSnapshot",

    "description": "Take automatic snapshots of the project metadata while in development.",

    "documentation": "README.md",

    "authors": [
        {
            "name": "Aidan Wilson",
            "email": "aidan.wilson@intersect.org.au",
            "institution": "Intersect Australia"
        }
    ],

    "framework-version": 16,

    "system-settings": [
        {
            "key": "enable-purpose-practice",
            "name": "Enable for <b>Practice / Just for fun</b> projects",
            "type": "checkbox"
        },
        {
            "key": "enable-purpose-other",
            "name": "Enable for <b>Other</b> projects",
            "type": "checkbox"
        },
        {
            "key": "enable-purpose-research",
            "name": "Enable for <b>Research</b> projects",
            "type": "checkbox"
        },
        {
            "key": "enable-purpose-quality",
            "name": "Enable for <b>Quality Improvement</b> projects",
            "type": "checkbox"
        },
        {
            "key": "enable-purpose-ops",
            "name": "Enable for <b>Operational Support</b> projects",
            "type": "checkbox"
        }
    ],

    "crons": [
        {
            "cron_name": "auto_snapshot",
            "cron_description": "Checks for project metadata changes and takes a data dictionary snapshot.",
            "method": "autoSnapshot",
            "cron_frequency": "1800",
             "cron_max_run_time": "86400"
        }
    ]
}
